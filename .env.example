# Example environment variables for local / Docker runs.
# Copy to .env (gitignored) or map these into application.properties.

JDBC_DRIVER=com.mysql.cj.jdbc.Driver
JDBC_URL=jdbc:mysql://localhost:3306/websystique?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
JDBC_USERNAME=myuser
JDBC_PASSWORD=mypassword
HIBERNATE_DIALECT=org.hibernate.dialect.MySQL8Dialect
